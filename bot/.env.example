# Discord bot (keep private). One bot serves every server: it watches the Discord guilds registered on the site.
DISCORD_BOT_TOKEN=
# Optional: guild the FIVEM_DB_* settings below belong to (single-server setup)
DISCORD_GUILD_ID=

# Where the staff site is hosted (no trailing slash), and the secret shared with the site (its BOT_API_TOKEN)
SITE_URL=http://localhost:3000
BOT_API_TOKEN=

# FiveM playtime (optional): the bot reads each game server's MySQL and pushes the totals to the site.
# Several servers: one database per Discord guild (every key but url is optional):
# FIVEM_DATABASES_JSON={"123456789012345678":{"url":"mysql://user:pass@host:3306/db","table":"users","discordColumn":"discord","playtimeColumn":"playtime","unit":"minutes"}}
FIVEM_DATABASES_JSON=
# Single server (applies to DISCORD_GUILD_ID):
# Use a read-only MySQL user. Example: mysql://user:password@host:3306/database
FIVEM_DB_URL=
FIVEM_DB_TABLE=users
FIVEM_DB_DISCORD_COLUMN=discord
FIVEM_DB_PLAYTIME_COLUMN=playtime
# seconds | minutes | hours
FIVEM_DB_PLAYTIME_UNIT=minutes

# Anti-raid: read message content to block Discord invites and links (privileged intent: enable
# "Message Content Intent" in the Developer Portal first, or the bot cannot log in).
BOT_MESSAGE_CONTENT=0
