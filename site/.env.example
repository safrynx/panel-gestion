# Web app
APP_URL=http://localhost:3000
SESSION_SECRET=replace-with-a-long-random-secret
# Database. Production: a Turso database (libSQL).  turso db create gtasun-staff ; turso db show gtasun-staff --url ; turso db tokens create gtasun-staff
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Local development only (used when TURSO_DATABASE_URL is empty): a SQLite file
DATABASE_PATH=./data/gtasun.sqlite
# Default time zone of the communities (each server can set its own): weeks run Monday-Sunday in it, and the Sunday AI summary uses it
APP_TIMEZONE=Europe/Paris

# Discord application / OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback
# Single-server version only: this guild is attached to the "default" server (which keeps the existing data). New servers are added from the panel.
DISCORD_GUILD_ID=

# Discord bot token: the site uses it for role changes and member search (never use NEXT_PUBLIC_ for secrets)
DISCORD_BOT_TOKEN=

# Legacy "default" server only (other servers are configured from their "Accès & rôles" page). Comma-separated Discord role IDs considered staff
DISCORD_STAFF_ROLE_IDS=

# Legacy "default" server only. JSON grade mapping: {"Helper":{"roleId":"123","level":1},"Moderator":{"roleId":"456","level":2}}
GRADE_ROLE_MAPPING_JSON={}

# FiveM agent: each server generates its own token in "Accès & rôles". This old shared token still works and maps to the "default" server.
FIVEM_AGENT_TOKEN=

# Platform owners (comma-separated Discord user IDs): access to every server, all permissions, and they create servers
PANEL_OWNER_IDS=


# Weekly AI appreciation (free tier). Sunday evening the bot summarises the week's comments and sets a pastille.
# Groq (free):   AI_BASE_URL=https://api.groq.com/openai/v1                           AI_MODEL=llama-3.3-70b-versatile
# Gemini (free): AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   AI_MODEL=gemini-2.0-flash
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile
# Default hour (community time) from which the Sunday summary runs (each server can set its own)
REVIEW_HOUR=20

# Secret shared with the bot project (same value as the bot's BOT_API_TOKEN). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BOT_API_TOKEN=
